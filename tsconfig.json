{
  "compilerOptions": {
    "target": "ES5",
    "lib": [
      "ES5"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.ts",
    "generated/typings/**/*.d.ts"
  ]
}